#!/usr/bin/env bash
set -euo pipefail

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

APP_VERSION="26.1007.30912"
if [[ -z "${HOSTED_CODEX_APP_ZIP:-}" ]]; then
  curl --fail --location --show-error --retry 3 \
    -o "$TEMP_DIR/file.zip" "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-arm64-$APP_VERSION.zip"
  export HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip"
fi

bash ./scripts/prepare_asar
